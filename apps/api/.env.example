# ============================================
# AURALIS API — Environment Variables
# Bu dosyayı .env.local olarak kopyalayın
# ============================================

NODE_ENV=development
PORT=4000

# PostgreSQL — auralis_app rolü kullanılır (superuser değil!)
DATABASE_URL="postgresql://auralis_app:CHANGE_IN_PRODUCTION_VAULT@localhost:5432/auralis_dev?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (Üretimde güçlü random secret kullanın)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION

# CORS
CORS_ORIGIN=http://localhost:3000
