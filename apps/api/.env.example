# ═══════════════════════════════════════════════════════════════════════════
# CALON API — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Bu dosyayi .env olarak kopyala ve degerleri doldur.
# Production'da tum "required" alanlar doldurulmali.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development                    # development | staging | production
PORT=4000                               # API port (default: 4000)

# ── Database ─────────────────────────────────────────────────────────────
# calon_app rolu kullanilir (superuser degil!)
# connection_limit: dev=5, prod tek instance=10, prod pgbouncer=1
DATABASE_URL="postgresql://calon_app:CHANGE_ME@localhost:5432/calon_dev?schema=public&connection_limit=5"
# Neon direct (non-pooler) endpoint — LISTEN/NOTIFY icin gerekli.
# Neon pooler LISTEN'i desteklemez (PgBouncer transaction mode).
# Tanimli degilse OutboxListenerService DATABASE_URL'den -pooler suffix'ini otomatik cikarir.
# DATABASE_DIRECT_URL="postgresql://calon_app:CHANGE_ME@ep-xxx.region.neon.tech/neondb?sslmode=require"

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                         # Production'da zorunlu

# ── Auth ─────────────────────────────────────────────────────────────────
# Uretimde: openssl rand -base64 64 ile uret (min 32 karakter)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION

# ── Odeme (Iyzico) ──────────────────────────────────────────────────────
IYZICO_API_KEY=                         # Iyzico merchant API key (min 10 char)
IYZICO_SECRET_KEY=                      # Iyzico merchant secret key (min 10 char)
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com  # Production: https://api.iyzipay.com
# IYZICO_CALLBACK_URL=                  # Webhook callback URL (opsiyonel)

# ── Platform URL'leri ────────────────────────────────────────────────────
# Production'da gercek domain'lerle degistir
SITE_URL=http://localhost:3000          # prod: https://calon.com.tr
APP_URL=http://localhost:3000           # prod: https://app.calon.com.tr
BOOKING_URL=http://localhost:3001       # prod: https://book.calon.com.tr
API_URL=http://localhost:4000           # prod: https://api.calon.com.tr

# ── CORS ─────────────────────────────────────────────────────────────────
# Virgulle ayrilmis origin listesi
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Observability (opsiyonel) ────────────────────────────────────────────
LOG_LEVEL=info                          # debug | info | warn | error
# SENTRY_DSN=                           # Sentry DSN (production)
# ADMIN_API_KEY=                        # Super admin API key (min 32 char)

# ── Rate Limiting (opsiyonel — default'lari var) ─────────────────────────
# PUBLIC_RATE_TTL_MS=60000              # Rate limit penceresi (ms)
# PUBLIC_HOLDS_LIMIT=10                 # Hold istegi limiti
# PUBLIC_BOOK_LIMIT=5                   # Booking istegi limiti

# ── Archive (opsiyonel) ─────────────────────────────────────────────────
# ARCHIVE_RETENTION_DAYS=90             # Arsiv saklama suresi (gun)
