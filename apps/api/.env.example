# ============================================================
# CALON API — Environment Variables
# Kopyala: cp .env.example .env.local
# ÜRETİMDE: Gerçek değerlerle değiştir, bu dosyayı commit etme!
# ============================================================

NODE_ENV=development
PORT=4000

# ── PostgreSQL ───────────────────────────────────────────────
# calon_app rolü kullanılır (superuser değil!)
# Superuser RLS politikalarını atlar — ÜRETİMDE KULLANMA
#
# Prisma bağlantı havuzu — ?connection_limit=N ile sınırla
#   Geliştirme: connection_limit=5 (Docker 100 max)
#   Üretim (tek instance): connection_limit=10
#   Üretim (Pgbouncer arkasında): connection_limit=1 (pool modu)
#   NOT: connection_limit eklemezsen Prisma her worker için 9 bağlantı açar
DATABASE_URL="postgresql://calon_app:CHANGE_IN_PRODUCTION_VAULT@localhost:5432/calon_dev?schema=public&connection_limit=5"

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────
# Üretimde: openssl rand -base64 64 ile üret
# Access token: 15 dakika (AppModule.JwtModule.signOptions.expiresIn)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Platform Domain Topology ───────────────────────────────────
# Üretimde gerçek domainlerle değiştir
SITE_URL=https://calon.com.tr
APP_URL=https://app.calon.com.tr
BOOKING_URL=https://book.calon.com.tr
API_URL=https://api.calon.com.tr
