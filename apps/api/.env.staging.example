# =============================================================================
# CALON API — STAGE ENVIRONMENT
# =============================================================================
# Bu dosyayi .env.staging olarak kopyala ve degerleri doldur.
# Prod secret'lari KULLANMA. Stage'e ozgu degerler uret.
# =============================================================================

# -- Core --------------------------------------------------------------------
NODE_ENV=staging
PORT=4000

# -- Database (Neon stage project / sanitize edilmis branch) -----------------
# Ayri Neon project veya prod'dan olusturulmus sanitize branch.
# Prod connection string'i buraya YAZMA.
DATABASE_URL=postgresql://calon_stage:CHANGE_ME@ep-XXXX.eu-central-1.aws.neon.tech/calon_stage?sslmode=require&connection_limit=5

# -- Redis (Ayri stage instance) ---------------------------------------------
# Prod Redis instance'i ile AYNI OLMAMALI.
REDIS_HOST=redis-XXXX.cloud.redislabs.com
REDIS_PORT=16379
REDIS_PASSWORD=CHANGE_ME

# -- Auth --------------------------------------------------------------------
# Stage'e ozgu secret uret: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_STAGE_ONLY_MIN_64_CHARS

# -- URLs (port'suz, Cloudflare arkasi) --------------------------------------
SITE_URL=https://stage.calon.com.tr
APP_URL=https://stage.calon.com.tr
BOOKING_URL=https://stage-book.calon.com.tr
API_URL=https://stage-api.calon.com.tr

# -- CORS --------------------------------------------------------------------
CORS_ORIGIN=https://stage.calon.com.tr,https://stage-book.calon.com.tr

# -- Payment (sandbox) -------------------------------------------------------
IYZICO_API_KEY=sandbox_api_key
IYZICO_SECRET_KEY=sandbox_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# -- Logging -----------------------------------------------------------------
LOG_LEVEL=info
