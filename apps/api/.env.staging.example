# =============================================================================
# CALON API — STAGE ENVIRONMENT
# =============================================================================
# Bu dosyayi .env.staging olarak kopyala ve degerleri doldur.
# Prod secret'lari KULLANMA. Stage'e ozgu degerler uret.
#
# HOST: Ayni Oracle Cloud instance (141.144.243.114), ayri compose stack.
# DB:   Neon branch (prod project uzerinde ayri branch, ayri project degil).
# REDIS: Upstash ayri database (fiziksel izolasyon, ayni redis YASAK).
# =============================================================================

# -- Core --------------------------------------------------------------------
NODE_ENV=staging
PORT=4001

# -- Database (Neon stage branch) --------------------------------------------
# Neon dashboard'dan prod project uzerinde "stage" branch olustur.
# Branch'in kendi connection string'ini buraya yaz.
# Prod connection string'i buraya YAZMA.
DATABASE_URL=postgresql://calon_stage:CHANGE_ME@ep-XXXX.eu-central-1.aws.neon.tech/calon_stage?sslmode=verify-full&connection_limit=5

# -- Redis (Upstash ayri database) -------------------------------------------
# Upstash console'dan AYRI bir database olustur (ornek ad: calon-stage).
# Prod Upstash database'i ile AYNI degerleri KULLANMA.
# Fiziksel izolasyon: ayri database = ayri host/password.
#
# Upstash endpoint → REDIS_HOST
# Upstash port     → REDIS_PORT
# Upstash password  → REDIS_PASSWORD
REDIS_HOST=XXXX.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# -- Auth --------------------------------------------------------------------
# Stage'e ozgu secret uret: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_STAGE_ONLY_MIN_64_CHARS

# -- URLs (port'suz, Cloudflare arkasi) --------------------------------------
SITE_URL=https://stage.calon.com.tr
APP_URL=https://stage.calon.com.tr
BOOKING_URL=https://stage-book.calon.com.tr
API_URL=https://stage-api.calon.com.tr

# -- CORS --------------------------------------------------------------------
CORS_ORIGIN=https://stage.calon.com.tr,https://stage-book.calon.com.tr

# -- Payment (sandbox) -------------------------------------------------------
IYZICO_API_KEY=sandbox_api_key
IYZICO_SECRET_KEY=sandbox_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# -- Logging -----------------------------------------------------------------
LOG_LEVEL=info

# -- Queue -------------------------------------------------------------------
# BULL_PREFIX ek isimlendirme icin kullanilir.
# Gercek izolasyon ayri REDIS_HOST/PASSWORD ile saglanir.
BULL_PREFIX=stage
