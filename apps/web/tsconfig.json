{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "jsx":              "preserve",
    "lib":              ["dom", "dom.iterable", "ES2022"],
    "plugins":          [{ "name": "next" }],
    "paths": {
      "@/*":            ["./src/*"],
      "@components/*":  ["./components/*"],
      "@lib/*":         ["./lib/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
