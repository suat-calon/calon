// =============================================================================
// CALON BUSINESS OS — PRISMA SCHEMA
// Mimari Anayasa: Sıfır Teknik Borç | Soft Delete | Multi-Tenant RLS
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  // Üretilen tip güvenli istemcinin kullanım yeri
  output        = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// BÖLÜM 1: IAM & TENANT (Kimlik ve Çok Kiracılı Yönetim)
// =============================================================================

enum TenantPlan {
  SOLO // Tek kişilik
  BOUTIQUE // 3–10 personel
  ENTERPRISE // Klinik / Zincir şube
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CHURNED
}

// =============================================================================
// BÖLÜM 12: BİLLİNG / PLAN ENGINE (Faz 12)
// =============================================================================

enum BillingCycle {
  MONTHLY
  YEARLY
}

/// Tenant'ın abonelik/ödeme durumu (Tenant.status'tan ayrı, billing odaklı)
enum BillingStatus {
  TRIAL // 7 günlük deneme — Pro feature set
  ACTIVE // Ödeme alındı, aktif
  PAST_DUE // Ödeme gecikti, grace period (3 gün) — kritik write'lar kapalı
  SUSPENDED // Grace bitti — sadece billing + auth erişimi
  CANCELED // Abonelik iptal edildi
}

enum BillingProvider {
  NONE // Ödeme altyapısı yok (test/manual)
  IYZICO
  PAYTR
  STRIPE
}

enum UsageEventType {
  SMS
  AI
}

model Tenant {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  slug       String       @unique // subdomain: slug.calon.com.tr
  plan       TenantPlan   @default(SOLO)
  status     TenantStatus @default(ACTIVE)
  brandColor String? // UI özelleştirme
  logoUrl    String?
  timezone   String       @default("Europe/Istanbul")
  locale     String       @default("tr-TR")
  currency   String       @default("TRY") // Para birimi (Faz 15)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
  isDeleted Boolean   @default(false)

  // İlişkiler
  users              UserTenant[]
  locations          Location[]
  customers          Customer[]
  appointments       Appointment[]
  services           Service[]
  serviceCategories  ServiceCategory[]
  products           Product[]
  staff              StaffProfile[]
  campaigns          CampaignTemplate[] // v2 placeholder
  refreshTokens      RefreshToken[]
  idempotencyKeys    IdempotencyKey[]
  auditLogs          AuditLog[]
  transactionLedgers TransactionLedger[]

  // Faz 12: Plan Engine
  billing             TenantBilling?
  usagePeriods        UsagePeriod[]
  usageEvents         UsageEvent[]
  entitlementSnapshot TenantEntitlementSnapshot?

  // Faz 15: Onboarding Wizard İdempotency
  onboardingIdempotencies OnboardingIdempotency[]

  // Faz 18: Viral Growth — Referrals
  referrals Referral[]

  // Faz 19: İyzico Ödeme Motoru
  payments Payment[]

  // Faz 22: Abonelik Billing Katmanı
  billingAttempts BillingAttempt[]

  // Faz 22.5: Billing Ledger
  billingPeriods BillingPeriod[]

  // Faz 23: Scheduling Engine
  appointmentHolds AppointmentHold[]
  staffShifts      StaffShift[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

enum UserRole {
  SUPER_ADMIN // Platform yöneticisi (Calon)
  TENANT_OWNER // İşletme sahibi
  MANAGER // Şube müdürü
  RECEPTIONIST // Resepsiyonist
  STAFF // Personel (kendi takvimini görür)
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(INVITED)

  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime? // Faz 15: e-posta doğrulama
  deletedAt       DateTime?
  isDeleted       Boolean   @default(false)

  // İlişkiler
  tenants       UserTenant[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([email])
  @@map("users")
}

model UserTenant {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tenantId   String   @db.Uuid
  role       UserRole @default(STAFF)
  locationId String?  @db.Uuid // Hangi şubeye atandı

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([userId, tenantId]) // Bir kullanıcı bir tenant'ta tek rol
  @@index([tenantId, role])
  @@map("user_tenants")
}

// =============================================================================
// BÖLÜM 2: LOKASYON VE KAYNAKLAR (Location, Room)
// =============================================================================

model Location {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  address  String?
  city     String?
  country  String  @default("TR")
  phone    String?
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  rooms        Room[]
  staff        StaffProfile[]
  appointments Appointment[]
  userTenants  UserTenant[]

  @@index([tenantId])
  @@map("locations")
}

model Room {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @db.Uuid
  locationId String  @db.Uuid
  name       String // "Oda 1", "Lazer Kabini"
  capacity   Int     @default(1)
  isActive   Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  location     Location      @relation(fields: [locationId], references: [id])
  appointments Appointment[]

  @@index([tenantId, locationId])
  @@map("rooms")
}

// =============================================================================
// BÖLÜM 3: PERSONEL (StaffProfile, StaffWorkingHour, StaffShift)
// =============================================================================

model StaffProfile {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @db.Uuid
  locationId     String  @db.Uuid
  userId         String? @db.Uuid // Sisteme bağlı ise
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  title          String? // "Saç Uzmanı", "Estetisyen"
  colorHex       String  @default("#6366f1") // Takvim rengi
  commissionRate Float   @default(0) // % cinsinden
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  location     Location           @relation(fields: [locationId], references: [id])
  workingHours StaffWorkingHour[]
  shifts       StaffShift[]
  appointments Appointment[]
  services     StaffService[]
  commissions  CommissionLog[]
  holds        AppointmentHold[] // Faz 23

  @@index([tenantId, locationId])
  @@map("staff_profiles")
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// Faz 23: Scheduling Engine
enum AppointmentHoldStatus {
  ACTIVE // Geçerli hold — slotu bloke eder
  CONSUMED // Randevuya dönüştürüldü (terminal)
  EXPIRED // Cron tarafından sona erdirildi (terminal)
  RELEASED // Kullanıcı/sistem tarafından serbest bırakıldı (terminal)
}

enum StaffShiftType {
  WORKING // Çalışma override (varsayılan)
  LEAVE // İzin — availability'den çıkar
  BLOCK // Genel blok (toplantı, kişisel, vb.)
}

enum ResourceType {
  ROOM
  EQUIPMENT
}

model StaffWorkingHour {
  id           String    @id @default(uuid()) @db.Uuid
  staffId      String    @db.Uuid
  dayOfWeek    DayOfWeek
  startTime    String // "09:00"
  endTime      String // "18:00"
  isWorkingDay Boolean   @default(true)
  breakStart   String? // "12:00"
  breakEnd     String? // "13:00"

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("staff_working_hours")
}

model StaffShift {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid // Faz 23: RLS + availability query
  staffId   String         @db.Uuid
  shiftType StaffShiftType @default(WORKING) // Faz 23: WORKING | LEAVE | BLOCK
  date      DateTime       @db.Date
  startTime DateTime
  endTime   DateTime
  notes     String?

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId, date]) // tenantId first for RLS + availability
  @@map("staff_shifts")
}

// =============================================================================
// BÖLÜM 4: HİZMET KATALOĞU (ServiceCategory, Service, StaffService, Product)
// =============================================================================

model ServiceCategory {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  name        String
  description String?
  colorHex    String  @default("#6366f1")
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  services Service[]

  @@index([tenantId])
  @@map("service_categories")
}

model Service {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  categoryId      String  @db.Uuid
  name            String
  description     String?
  durationMin     Int // Dakika cinsinden süre
  price           Decimal @db.Decimal(10, 2)
  currency        String  @default("TRY")
  depositRate     Float   @default(0) // Kaparo oranı (0–1)
  requiresDeposit Boolean @default(false) // Faz 19: true → randevu PENDING_PAYMENT başlar
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  tenant               Tenant                       @relation(fields: [tenantId], references: [id])
  category             ServiceCategory              @relation(fields: [categoryId], references: [id])
  staffServices        StaffService[]
  appointments         Appointment[]
  productUsages        ServiceProduct[]
  holds                AppointmentHold[] // Faz 23
  resourceRequirements ServiceResourceRequirement[] // Faz 23

  @@index([tenantId, categoryId])
  @@map("services")
}

model StaffService {
  staffId   String @db.Uuid
  serviceId String @db.Uuid

  staff   StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

/// Hizmetin kaynak gereksinimi (oda, ekipman). Minimal — Faz 24'te genişletilir.
model ServiceResourceRequirement {
  id           String       @id @default(uuid()) @db.Uuid
  serviceId    String       @db.Uuid
  resourceType ResourceType
  resourceId   String?      @db.Uuid // null = bu türden herhangi biri
  quantity     Int          @default(1)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_resource_requirements")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  name        String
  sku         String?
  unit        String  @default("ml") // ml, gr, adet
  stockAmount Decimal @default(0) @db.Decimal(10, 3)
  minStock    Decimal @default(0) @db.Decimal(10, 3)
  costPrice   Decimal @default(0) @db.Decimal(10, 2)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  serviceUsages ServiceProduct[]
  stockLogs     StockLog[]

  @@index([tenantId])
  @@map("products")
}

model ServiceProduct {
  serviceId   String  @db.Uuid
  productId   String  @db.Uuid
  usageAmount Decimal @db.Decimal(10, 3) // Kullanılacak miktar (gram/ml)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([serviceId, productId])
  @@map("service_products")
}

model StockLog {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  tenantId  String   @db.Uuid
  delta     Decimal  @db.Decimal(10, 3) // + giriş, – çıkış
  reason    String // "appointment:uuid" | "manual"
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, productId])
  @@index([createdAt])
  @@map("stock_logs")
}

// =============================================================================
// BÖLÜM 5: MÜŞTERİ VE SADAKAT (Customer, LoyaltyTransaction)
// =============================================================================

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  firstName   String
  lastName    String
  email       String?
  phone       String?
  dateOfBirth DateTime? @db.Date
  gender      String?
  avatarUrl   String?
  notes       String?

  // Sadakat
  loyaltyTier   LoyaltyTier @default(BRONZE)
  loyaltyPoints Int         @default(0)

  // Faz 18: Viral Growth — Referral kodu
  referralCode String? @unique // aur-{RANDOM6}

  // KVKK/GDPR
  consentGiven Boolean   @default(false)
  consentDate  DateTime?
  anonymizedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isDeleted Boolean   @default(false)

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  appointments        Appointment[]
  loyaltyTransactions LoyaltyTransaction[]
  consentForms        ConsentForm[]
  photos              CustomerPhoto[]

  // Faz 18: Referral ilişkileri
  referralsMade     Referral[] @relation("ReferralReferrer")
  referralsReceived Referral[] @relation("ReferralReferred")

  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@map("customers")
}

enum LoyaltyAction {
  EARNED_APPOINTMENT
  EARNED_REFERRAL
  EARNED_REVIEW
  REDEEMED
  EXPIRED
  ADJUSTED
}

model LoyaltyTransaction {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  customerId     String        @db.Uuid
  appointmentId  String?       @db.Uuid
  action         LoyaltyAction
  points         Int // + kazanım, – harcama
  balanceAfter   Int
  description    String?
  // İdempotency: aynı işlem iki kez uygulanmaz (UNIQUE kısıtı)
  idempotencyKey String?       @unique

  createdAt DateTime @default(now())

  customer    Customer     @relation(fields: [customerId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tenantId, customerId])
  @@map("loyalty_transactions")
}

// =============================================================================
// BÖLÜM 6: RANDEVU (Appointment) — GIST CONSTRAINT BURADA
// NOT: EXCLUDE USING GIST kısıtlaması Raw SQL migration'da tanımlanacak.
// Prisma doğrudan EXCLUDE sözdizimini desteklemediğinden
// bu kritik kural migration dosyasına ham SQL olarak yazılır.
// =============================================================================

enum AppointmentStatus {
  PENDING_PAYMENT // Ödeme bekleniyor (iyzico kaparo akışı)
  PAID // Ödeme tamamlandı, onay bekliyor
  PENDING // Taslak / ön kayıt (ödeme gerektirmeyen randevular)
  CONFIRMED // Onaylandı
  CHECKED_IN // Müşteri geldi
  IN_SERVICE // Hizmet devam ediyor
  COMPLETED // Tamamlandı
  CANCELLED // İptal edildi
  NO_SHOW // Gelmedi
}

enum AppointmentSource {
  WALK_IN // Kapıdan gelen
  PHONE // Telefon
  WHATSAPP // WhatsApp (v2)
  ONLINE // Online self-booking
  AI_ASSISTANT // Yapay Zeka (v2)
  RECEPTIONIST // Resepsiyonist
}

model Appointment {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @db.Uuid
  customerId String  @db.Uuid
  staffId    String  @db.Uuid
  serviceId  String  @db.Uuid
  locationId String  @db.Uuid
  roomId     String? @db.Uuid

  status AppointmentStatus @default(PENDING)
  source AppointmentSource @default(RECEPTIONIST)

  startTime DateTime // GIST kısıtlaması bu alana bakacak
  endTime   DateTime

  notes         String?
  internalNotes String? // Personel notu
  depositPaid   Decimal? @db.Decimal(10, 2)
  totalPrice    Decimal? @db.Decimal(10, 2)

  // Mükerrer işlem koruması
  idempotencyKey String? @unique

  // Audit hash (manipülasyon tespiti)
  integrityHash String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  cancelledAt        DateTime?
  cancellationReason String?
  // Soft delete: Randevular asla fiziksel silinmez
  isDeleted          Boolean   @default(false)
  // Faz 21: Self-Onboarding Wizard test randevusu işareti
  isTestBooking      Boolean   @default(false)

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])
  staff    StaffProfile @relation(fields: [staffId], references: [id])
  service  Service      @relation(fields: [serviceId], references: [id])
  location Location     @relation(fields: [locationId], references: [id])
  room     Room?        @relation(fields: [roomId], references: [id])

  loyaltyTransactions LoyaltyTransaction[]
  transactions        TransactionLedger[]
  commissions         CommissionLog[]
  consentForms        ConsentForm[]
  photos              CustomerPhoto[]

  // Faz 18: Referral ilişkisi
  referral Referral?

  // Faz 19: İyzico ödeme ilişkisi
  payment Payment?

  @@index([tenantId, staffId, startTime, endTime]) // Müsaitlik sorguları
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([startTime])
  @@map("appointments")
}

/// DB-backed slot kilidi. Redis NX + DB GIST çift katman güvencesi.
/// Durum: ACTIVE → CONSUMED (booking) | EXPIRED (cron) | RELEASED (user/system)
model AppointmentHold {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @db.Uuid
  staffId   String                @db.Uuid
  serviceId String                @db.Uuid
  startTime DateTime
  endTime   DateTime
  expiresAt DateTime
  status    AppointmentHoldStatus @default(ACTIVE)
  holdToken String? // Opaque client token (UUID)

  createdAt DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  staff   StaffProfile @relation(fields: [staffId], references: [id])
  service Service      @relation(fields: [serviceId], references: [id])

  @@index([tenantId, staffId, startTime])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("appointment_holds")
}

// =============================================================================
// BÖLÜM 7: FİNANS (TransactionLedger, CommissionLog)
// =============================================================================

enum TransactionType {
  PAYMENT_CASH
  PAYMENT_CARD
  PAYMENT_ONLINE
  DEPOSIT
  REFUND
  COMMISSION_PAYOUT
  ADJUSTMENT
}

model TransactionLedger {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  appointmentId String?         @db.Uuid
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("TRY")
  description   String?
  reference     String? // Harici ödeme referansı
  processedAt   DateTime        @default(now())

  // KVKK: Finansal veriler 10 yıl saklanır, kişisel veriler anonimleştirilir
  isDeleted Boolean @default(false)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tenantId, processedAt])
  @@index([appointmentId])
  @@map("transaction_ledger")
}

model CommissionLog {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  staffId       String    @db.Uuid
  appointmentId String    @db.Uuid
  amount        Decimal   @db.Decimal(10, 2)
  rate          Float
  periodStart   DateTime  @db.Date
  periodEnd     DateTime  @db.Date
  isPaid        Boolean   @default(false)
  paidAt        DateTime?

  staff       StaffProfile @relation(fields: [staffId], references: [id])
  appointment Appointment  @relation(fields: [appointmentId], references: [id])

  @@index([tenantId, staffId, isPaid])
  @@map("commission_logs")
}

// =============================================================================
// BÖLÜM 8: YASAL UYUM (ConsentForm — KVKK/GDPR)
// =============================================================================

model ConsentForm {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  customerId    String   @db.Uuid
  appointmentId String?  @db.Uuid
  formType      String // "KVKK", "GDPR", "TREATMENT"
  content       String   @db.Text // Form içeriği anlık snapshot
  signedAt      DateTime
  ipAddress     String?
  userAgent     String?

  customer    Customer     @relation(fields: [customerId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tenantId, customerId])
  @@map("consent_forms")
}

// =============================================================================
// BÖLÜM 8.5: GALERİ (CustomerPhoto — Öncesi/Sonrası Fotoğraflar)
// KVKK Madde 6 kapsamında "özel nitelikli kişisel veri" (sağlık/biyometrik).
// Fotoğraflar S3/Object Storage'da; burada yalnızca URL metadata'sı saklanır.
// Silme: CustomerService.handleDeletionRequest() → isDeleted: true (GDPR akışı)
// =============================================================================

enum PhotoType {
  BEFORE // İşlem öncesi
  AFTER // İşlem sonrası
  PROGRESS // Süreç (çok seanslı tedaviler)
}

model CustomerPhoto {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid // Tenant izolasyonu (FK yok — middleware yönetir)
  customerId    String    @db.Uuid
  appointmentId String?   @db.Uuid
  photoType     PhotoType
  url           String // Tam boyut S3 URL
  thumbnailUrl  String? // Küçük boy önizleme URL
  bodyArea      String? // "Yüz", "Saç", "Vücut" vb.
  notes         String?
  takenAt       DateTime  @default(now()) // Fotoğrafın çekildiği an
  uploadedAt    DateTime  @default(now()) // Sisteme yüklenme anı
  isDeleted     Boolean   @default(false) // GDPR: soft-delete (fiziksel silme yapılmaz)

  customer    Customer     @relation(fields: [customerId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tenantId, customerId])
  @@index([tenantId, appointmentId])
  @@map("customer_photos")
}

// =============================================================================
// BÖLÜM 9: GÜVENLİK (RefreshToken, IdempotencyKey)
// =============================================================================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  tenantId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  // Token Reuse Detection için hangi cihazdan
  userAgent String?
  ipAddress String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // TTL temizliği
  @@map("refresh_tokens")
}

model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique // "appointment:{uuid}" | "payment:{uuid}"
  tenantId  String   @db.Uuid
  response  Json? // Başarılı yanıtı sakla
  createdAt DateTime @default(now())
  expiresAt DateTime // 24 saat sonra temizlenir

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([expiresAt]) // TTL index
  @@map("idempotency_keys")
}

// =============================================================================
// BÖLÜM 10: AUDIT LOG (Her kritik değişiklik için)
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  entityType String // "Appointment", "Customer", vb.
  entityId   String   @db.Uuid
  action     String // "CONFIRM", "CANCEL", "GDPR_DELETION"
  actorId    String?  @db.Uuid // Kim yaptı
  actorRole  String?
  before     Json? // Önceki durum
  after      Json? // Sonraki durum
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// BÖLÜM 11: v2 PLACEHOLDER (AI/WhatsApp — Schema var, endpoint YOK)
// =============================================================================

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

/// v2: AI asistan mesaj geçmişi. v1'de tablo oluşturulur ama kullanılmaz.
model Message {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  customerId String?          @db.Uuid
  channel    MessageChannel
  direction  MessageDirection
  content    String           @db.Text
  intent     String? // Tespit edilen niyet
  sessionId  String?
  createdAt  DateTime         @default(now())

  @@index([tenantId, customerId])
  @@index([sessionId])
  @@map("messages")
}

// =============================================================================
// BÖLÜM 12: BİLLİNG MODELLERİ (Faz 12 — Plan Engine)
// =============================================================================

/// Tenant başına 1:1 fatura/abonelik kaydı. Gerçek kaynak TenantBilling'dir.
model TenantBilling {
  tenantId               String          @id @db.Uuid
  plan                   TenantPlan      @default(SOLO)
  cycle                  BillingCycle    @default(MONTHLY)
  status                 BillingStatus   @default(TRIAL)
  trialEndsAt            DateTime
  graceUntil             DateTime
  currentPeriodStart     DateTime        @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean         @default(false)
  provider               BillingProvider @default(NONE)
  providerSubscriptionId String?
  lastPaymentAt          DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_billing")
}

/// Dönem bazlı kullanım kotası. Her fatura döneminde yeni kayıt oluşturulur.
model UsagePeriod {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  periodStart       DateTime
  periodEnd         DateTime
  smsIncluded       Int      @default(0)
  smsUsed           Int      @default(0)
  aiIncluded        Int      @default(0)
  aiUsed            Int      @default(0)
  extraSmsPurchased Int      @default(0)
  extraAiPurchased  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, periodStart])
  @@map("usage_periods")
}

/// Append-only kullanım olayları. Dispute için event log'dan doğrulanabilir.
model UsageEvent {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  type           UsageEventType
  units          Int
  idempotencyKey String         @unique
  /// Dış servis benzersiz işlem kimliği (SMS sağlayıcısı, ödeme sistemi vs.)
  /// Provider ID yoksa servis katmanı "internal:{idempotencyKey}" fallback üretir.
  /// Aynı externalId ile ikinci istek gelirse P2002 fırlar → sessizce yutulan = çifte sayım koruması.
  externalId     String         @unique
  occurredAt     DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@map("usage_events")
}

/// Redis-eş önbellek. Gerçek kaynak TenantBilling + PlanCatalog'dur; bu tablo sadece DB cache.
model TenantEntitlementSnapshot {
  tenantId     String        @id @db.Uuid
  featuresJson Json
  limitsJson   Json
  quotaJson    Json
  status       BillingStatus
  isTrial      Boolean
  updatedAt    DateTime      @updatedAt
  version      Int           @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_entitlement_snapshots")
}

/// v2: Kampanya şablonları. v1'de tablo oluşturulur ama kullanılmaz.
model CampaignTemplate {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  name      String
  channel   MessageChannel
  subject   String?
  body      String         @db.Text
  isActive  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("campaign_templates")
}

// =============================================================================
// BÖLÜM 9: FAZ 13 — RESILIENCE (Dead Letter Queue)
// =============================================================================

/// Bull kuyruğundaki kalıcı başarısız job'ları saklar.
/// 3 deneme sonrası hâlâ hata veren job'lar buraya taşınır.
/// @OnQueueFailed → FailedJobService.save() çağırır.
model FailedJob {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid // job.data.tenantId varsa doldurulur
  queueName String // Örn: "loyalty-earn", "stock-deduct"
  jobName   String // Örn: "earn-points", "deduct-stock"
  jobId     String // Bull job.id
  jobData   Json // Orijinal job payload
  errorMsg  String   @db.Text // son hata mesajı
  attempts  Int // kaç kez denendi
  failedAt  DateTime @default(now())

  @@index([queueName, failedAt])
  @@map("failed_jobs")
}

// =============================================================================
// BÖLÜM 15: ONBOARDING WIZARD İDEMPOTENCY (Faz 15)
// =============================================================================

/// Setup wizard'ın tekrar çalıştırılmasını önler.
/// (tenantId, key) UNIQUE: aynı tenant + Idempotency-Key bir kez çalışır.
model OnboardingIdempotency {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String // Idempotency-Key header değeri
  response  Json // Başarılı wizard yanıtı
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("onboarding_idempotency")
}

// =============================================================================
// BÖLÜM 18: VİRAL GROWTH — REFERRAL ENGINE (Faz 18)
// =============================================================================

/// Müşteri referans kayıtları.
/// @@unique([referrerCustomerId, referredCustomerId]): aynı çift bir kez ödüllendirilir (P2002 idempotency).
/// @@index([tenantId, referrerCustomerId]): referrer performans sorguları için.
model Referral {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  referrerCustomerId String   @db.Uuid
  referredCustomerId String   @db.Uuid
  appointmentId      String   @unique @db.Uuid // Tetikleyen randevu (1-to-1)
  awardedPoints      Int      @default(0) // Verilen puan
  createdAt          DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  referrer    Customer    @relation("ReferralReferrer", fields: [referrerCustomerId], references: [id])
  referred    Customer    @relation("ReferralReferred", fields: [referredCustomerId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([referrerCustomerId, referredCustomerId]) // P2002 idempotency
  @@index([tenantId, referrerCustomerId]) // Acceptance criteria
  @@map("referrals")
}

// =============================================================================
// BÖLÜM 19: İYZİCO ÖDEME MOTORU (Faz 19)
// =============================================================================

enum PaymentStatus {
  PENDING // Ödeme URL'i üretildi, kullanıcı ödeme yapmadı
  PAID // İyzico webhook → başarılı ödeme
  FAILED // İyzico webhook → başarısız / iptal
  REFUNDED // İade edildi
}

/// İyzico kaparo ödemeleri.
/// providerId @unique: aynı iyzico transaction iki kez işlenmez (idempotency).
/// appointmentId @unique: bir randevunun en fazla bir Payment kaydı olabilir.
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  appointmentId String        @unique @db.Uuid
  providerId    String?       @unique // İyzico paymentId (webhook'ta gelir)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("TRY")
  status        PaymentStatus @default(PENDING)
  paymentUrl    String? // İyzico checkout sayfası URL'i
  providerMeta  Json? // Ham İyzico yanıtı (audit trail)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([tenantId])
  @@map("payments")
}

// =============================================================================
// BÖLÜM 22: ABONELIK & BİLLİNG KATMANI (Faz 22)
// =============================================================================

enum BillingAttemptStatus {
  PENDING // Ödeme formu başlatıldı, webhook bekleniyor
  SUCCEEDED // İyzico webhook → başarılı ödeme, tenant aktif
  FAILED // İyzico webhook → başarısız ya da cron TTL doldu
}

/// Abonelik ödeme girişimi. conversationId = attemptId (İyzico'ya gönderilir).
/// providerPaymentId NOT UNIQUE — idempotency webhook_events.providerEventId @unique üzerinden sağlanır.
/// expiresAt: 30 dakika sonra cron tarafından FAILED yapılır (cron/webhook race guard ile).
model BillingAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @db.Uuid
  plan              TenantPlan
  cycle             BillingCycle
  amountCents       Int // Fiyat snapshot — PLAN_PRICES değişse bile korunur
  currency          String               @default("TRY")
  status            BillingAttemptStatus @default(PENDING)
  providerPaymentId String? // İyzico paymentId (webhook'ta gelir)
  providerMeta      Json?

  expiresAt DateTime // TTL: oluşturulma + 30 dakika

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status, expiresAt])
  @@index([tenantId, plan])
  @@index([tenantId, status])
  @@map("billing_attempts")
}

// =============================================================================
// BÖLÜM 22.5: BILLING LEDGER (Faz 22.5)
// =============================================================================

/// Abonelik dönemi ledger kaydı — immutable billing history.
/// Kural: kayıtlar sadece status alanı üzerinden değiştirilebilir (ACTIVE → CLOSED/REFUNDED).
/// UPDATE yapılmayacak; her ödeme yeni bir satır oluşturur.
enum BillingPeriodStatus {
  ACTIVE // Dönem devam ediyor
  CLOSED // Dönem kapandı (yenileme tamamlandı veya iptal)
  REFUNDED // İade edildi
}

model BillingPeriod {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @db.Uuid
  plan              TenantPlan
  cycle             BillingCycle
  status            BillingPeriodStatus @default(ACTIVE)
  amountCents       Int // Ödenen tutar snapshot (değişmez)
  currency          String              @default("TRY")
  periodStart       DateTime
  periodEnd         DateTime
  attemptId         String?             @db.Uuid // Kaynak BillingAttempt.id
  providerPaymentId String? // İyzico paymentId
  createdAt         DateTime            @default(now())
  // updatedAt kasıtlı yok — immutable ledger kuralı

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, periodStart])
  @@index([tenantId, status])
  @@index([attemptId])
  @@map("billing_periods")
}

/// Gelen webhook olayları — idempotency kalkanı.
/// providerEventId @unique: aynı iyzico olayı iki kez işlenmez (P2002 → 200 dön).
model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  source          String // 'iyzico_billing' | 'iyzico_payment'
  providerEventId String    @unique // paymentId ?? iyziReferenceCode
  eventType       String // 'checkout_payment' veya status değeri
  payload         Json
  tenantId        String?   @db.Uuid // null ise attempt bulunamadı
  processedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([source, eventType])
  @@index([tenantId])
  @@map("webhook_events")
}
