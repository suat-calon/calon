packages/database/node_modules/.prisma/
packages/database/src/generated/
packages/database/generated/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage/
.nyc_output/

# Docker overrides (local only)
docker-compose.override.yml

# Next.js generated files (auto-created by next dev/build)
apps/web/next-env.d.ts
apps/web/tsconfig.tsbuildinfo

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Test fixtures & results (generated — not committed)
test/fixtures/tenants.json
test/results/*.json
